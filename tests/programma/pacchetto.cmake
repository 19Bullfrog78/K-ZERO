# K-Zero - prova sul programma: prepara il pacchetto dati da controllare, copia di un pacchetto di base
# (es. esempi/demo) con UNA sola modifica. Cosi' ogni pacchetto rotto nasce dal demo cambiando un solo valore,
# senza tenere copie dei file nel repository.
# Lo usa caso.cmake quando il caso ha PACCHETTO_BASE (cartella di partenza), PACCHETTO (cartella da creare)
# e MODIFICA = <operazione>;<argomenti>:
#   IMPOSTA     <file> <percorso JSON> <valore JSON>  cambia un valore (oltre la fine di un elenco: lo aggiunge)
#   TOGLI       <file> <percorso JSON>                toglie un campo o un elemento di un elenco
#   SOSTITUISCI <file> <testo> <nuovo testo>          cambia un testo che compare una volta sola nel file
#                                                    (per i file che non devono restare JSON validi); nel nuovo
#                                                    testo @BYTE-hh@ e' un byte scritto in esadecimale (es.
#                                                    @BYTE-EC@ = la "i" accentata di un file salvato come ANSI)
#   ELIMINA     <file>                                toglie un file
#   AGGIUNGI    <file> <contenuto>                    aggiunge un file
#   CARTELLA    <nome>                                aggiunge una cartella (al posto del file con quel nome, se c'e')
#   PIPE        <file>                                mette una "pipe" al posto del file (non Windows)
#   BYTE        <file> <posizione>                    cambia un byte (XOR con 1; posizione negativa: dalla fine) (K-010:
#                                                    cassaforte e registro, file binari)
#   TRONCA      <file> <lunghezza>                    tronca il file a quella lunghezza
#   ALLUNGA     <file> <byte>                         porta il file a quella lunghezza con zeri "sparsi", che non
#                                                    occupano il disco (Linux, comando truncate)
#   COLLEGA     <file> <destinazione>                 mette un collegamento simbolico al posto del file (non Windows):
#                                                    @FUORI@ = al file spostato fuori dalla cartella del pacchetto,
#                                                    @DENTRO@ = al file spostato nella sottocartella "archivio",
#                                                    altrimenti alla destinazione scritta (es. /dev/zero)
# IMPOSTA e TOGLI riscrivono il file con lo stesso contenuto JSON (cambiano solo spazi e ordine dei campi).
# Senza MODIFICA: copia esatta della base. La cartella "<pacchetto>.nuova" (negli argomenti @NUOVA@) si toglie ogni volta.
cmake_minimum_required(VERSION 3.25)

function(fallisci_pacchetto messaggio)
  message(FATAL_ERROR "Prova ${NOME}, preparazione del pacchetto: ${messaggio}")
endfunction()

# "/corse/3/passaggi/2" -> corse;3;passaggi;2 (percorso JSON standard, RFC 6901)
function(percorso_json puntatore uscita)
  if(NOT puntatore MATCHES "^/")
    fallisci_pacchetto("percorso JSON senza / iniziale: ${puntatore}")
  endif()
  string(SUBSTRING "${puntatore}" 1 -1 resto)
  string(REPLACE "/" ";" parti "${resto}")
  set(out "")
  foreach(p IN LISTS parti)
    string(REPLACE "~1" "/" p "${p}")
    string(REPLACE "~0" "~" p "${p}")
    list(APPEND out "${p}")
  endforeach()
  set(${uscita} "${out}" PARENT_SCOPE)
endfunction()

file(REMOVE_RECURSE "${PACCHETTO}" "${PACCHETTO}.fuori" "${PACCHETTO}.nuova")
file(GLOB temporanee LIST_DIRECTORIES true "${CARTELLA}/.${NOME}.pacchetto.nuova.kzero-*")
if(temporanee)
  file(REMOVE_RECURSE ${temporanee})
endif()
file(MAKE_DIRECTORY "${PACCHETTO}")
file(GLOB originali LIST_DIRECTORIES false "${PACCHETTO_BASE}/*")
if(NOT originali)
  fallisci_pacchetto("cartella di base vuota o inesistente: ${PACCHETTO_BASE}")
endif()
file(COPY ${originali} DESTINATION "${PACCHETTO}")

# K-010: senza MODIFICA il pacchetto e' una copia esatta della base (es. un pacchetto chiuso, che i comandi cambiano).
list(LENGTH MODIFICA quanti)
if(quanti EQUAL 0)
  return()
endif()
if(quanti LESS 2)
  fallisci_pacchetto("MODIFICA incompleta: ${MODIFICA}")
endif()
list(GET MODIFICA 0 operazione)
list(GET MODIFICA 1 nome_file)
set(file_modificato "${PACCHETTO}/${nome_file}")

if(operazione STREQUAL "IMPOSTA" OR operazione STREQUAL "TOGLI")
  file(READ "${file_modificato}" testo)
  list(GET MODIFICA 2 puntatore)
  percorso_json("${puntatore}" percorso)
  if(operazione STREQUAL "IMPOSTA")
    list(GET MODIFICA 3 valore)
    string(JSON nuovo ERROR_VARIABLE problema SET "${testo}" ${percorso} "${valore}")
  else()
    string(JSON nuovo ERROR_VARIABLE problema REMOVE "${testo}" ${percorso})
  endif()
  if(problema)
    fallisci_pacchetto("${operazione} ${nome_file} ${puntatore}: ${problema}")
  endif()
  file(WRITE "${file_modificato}" "${nuovo}\n")
elseif(operazione STREQUAL "BYTE" OR operazione STREQUAL "TRONCA")
  list(GET MODIFICA 2 numero)
  if(operazione STREQUAL "TRONCA")
    set(comando_byte "${CAMBIA_BYTE}" "${file_modificato}" tronca "${numero}")
  else()
    set(comando_byte "${CAMBIA_BYTE}" "${file_modificato}" "${numero}")
  endif()
  execute_process(COMMAND ${comando_byte} RESULT_VARIABLE esito_byte)
  if(NOT esito_byte EQUAL 0)
    fallisci_pacchetto("${operazione} ${nome_file} ${numero}: esito ${esito_byte}")
  endif()
elseif(operazione STREQUAL "SOSTITUISCI")
  file(READ "${file_modificato}" testo)
  list(GET MODIFICA 2 vecchio)
  list(GET MODIFICA 3 nuovo)
  string(REGEX MATCHALL "@BYTE-[0-9A-F][0-9A-F]@" bytes "${nuovo}")
  foreach(b IN LISTS bytes)
    string(SUBSTRING "${b}" 6 2 esadecimale)
    math(EXPR valore "0x${esadecimale}")
    string(ASCII ${valore} carattere)
    string(REPLACE "${b}" "${carattere}" nuovo "${nuovo}")
  endforeach()
  string(FIND "${testo}" "${vecchio}" primo)
  string(FIND "${testo}" "${vecchio}" ultimo REVERSE)
  if(primo EQUAL -1 OR NOT primo EQUAL ultimo)
    fallisci_pacchetto("il testo da sostituire deve comparire una volta sola in ${nome_file}: ${vecchio}")
  endif()
  string(REPLACE "${vecchio}" "${nuovo}" testo "${testo}")
  file(WRITE "${file_modificato}" "${testo}")
elseif(operazione STREQUAL "ELIMINA")
  if(NOT EXISTS "${file_modificato}")
    fallisci_pacchetto("il file da togliere non c'e': ${nome_file}")
  endif()
  file(REMOVE "${file_modificato}")
elseif(operazione STREQUAL "AGGIUNGI")
  list(GET MODIFICA 2 contenuto)
  file(WRITE "${file_modificato}" "${contenuto}")
elseif(operazione STREQUAL "CARTELLA")
  file(REMOVE "${file_modificato}")
  file(MAKE_DIRECTORY "${file_modificato}")
elseif(operazione STREQUAL "PIPE")
  file(REMOVE "${file_modificato}")
  execute_process(COMMAND mkfifo "${file_modificato}" RESULT_VARIABLE problema)
  if(problema)
    fallisci_pacchetto("mkfifo ${nome_file}: ${problema}")
  endif()
elseif(operazione STREQUAL "ALLUNGA")
  list(GET MODIFICA 2 byte)
  execute_process(COMMAND truncate -s "${byte}" "${file_modificato}" RESULT_VARIABLE problema)
  if(problema)
    fallisci_pacchetto("truncate ${nome_file}: ${problema}")
  endif()
elseif(operazione STREQUAL "COLLEGA")
  list(GET MODIFICA 2 destinazione)
  if(destinazione STREQUAL "@FUORI@")
    file(MAKE_DIRECTORY "${PACCHETTO}.fuori")
    file(RENAME "${file_modificato}" "${PACCHETTO}.fuori/${nome_file}")
    set(destinazione "${PACCHETTO}.fuori/${nome_file}")
  elseif(destinazione STREQUAL "@DENTRO@")
    file(MAKE_DIRECTORY "${PACCHETTO}/archivio")
    file(RENAME "${file_modificato}" "${PACCHETTO}/archivio/${nome_file}")
    set(destinazione "archivio/${nome_file}")
  else()
    file(REMOVE "${file_modificato}")
  endif()
  file(CREATE_LINK "${destinazione}" "${file_modificato}" SYMBOLIC RESULT problema)
  if(NOT problema EQUAL 0)
    fallisci_pacchetto("collegamento ${nome_file} -> ${destinazione}: ${problema}")
  endif()
else()
  fallisci_pacchetto("operazione sconosciuta: ${operazione}")
endif()
