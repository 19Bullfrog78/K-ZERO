# K-Zero - prova sull'elenco dei componenti esterni (docs/componenti.cdx.json, formato CycloneDX 1.5): coincide con
# quello che la compilazione e le prove scaricano davvero.
# - Ogni libreria di CMakeLists.txt (FetchContent_Declare) e' nell'elenco con lo stesso indirizzo, la stessa impronta
#   (SHA-256 del file, o SHA-1 del commit git) e la versione scritta accanto; e nessuna in piu'.
# - Ogni pacchetto Python di tests/strumenti/check-jsonschema.txt e' nell'elenco con la stessa versione e le stesse
#   impronte; e nessuno in piu'.
# - Ogni componente ha nome, versione, provenienza, impronta, licenza, uso (programma o prove) e lo "scope" che va con
#   l'uso (required = entra nel programma, excluded = solo nelle prove).
# Uso: cmake -DSORGENTI=<cartella del repository> -DVERSIONE=<versione di K-Zero> -P componenti.cmake
cmake_minimum_required(VERSION 3.25)

function(fallisci messaggio)
  message(FATAL_ERROR "docs/componenti.cdx.json: ${messaggio}")
endfunction()

file(READ "${SORGENTI}/docs/componenti.cdx.json" bom)
string(JSON formato GET "${bom}" bomFormat)
string(JSON versione_formato GET "${bom}" specVersion)
if(NOT formato STREQUAL "CycloneDX" OR NOT versione_formato STREQUAL "1.5")
  fallisci("deve essere CycloneDX 1.5, invece ${formato} ${versione_formato}")
endif()
string(JSON versione_kzero GET "${bom}" metadata component version)
if(NOT versione_kzero STREQUAL "${VERSIONE}")
  fallisci("versione di K-Zero ${versione_kzero}, quella del progetto e' ${VERSIONE}")
endif()

# Tutti i componenti: bom-ref -> indice; controllo dei campi obbligatori.
string(JSON quanti LENGTH "${bom}" components)
math(EXPR ultimo "${quanti} - 1")
set(riferimenti "")
foreach(i RANGE ${ultimo})
  string(JSON rif GET "${bom}" components ${i} bom-ref)
  list(APPEND riferimenti "${rif}")
  set(indice_${rif} ${i})
  foreach(campo name version purl scope)
    string(JSON valore ERROR_VARIABLE manca GET "${bom}" components ${i} ${campo})
    if(manca OR valore STREQUAL "")
      fallisci("il componente ${rif} non ha ${campo}")
    endif()
  endforeach()
  foreach(elenco hashes licenses externalReferences properties)
    string(JSON n ERROR_VARIABLE manca LENGTH "${bom}" components ${i} ${elenco})
    if(manca OR n EQUAL 0)
      fallisci("il componente ${rif} non ha ${elenco}")
    endif()
  endforeach()
  string(JSON licenza ERROR_VARIABLE manca GET "${bom}" components ${i} licenses 0 license id)
  if(manca OR licenza STREQUAL "")
    fallisci("il componente ${rif} non ha la licenza (codice SPDX)")
  endif()
  string(JSON uso GET "${bom}" components ${i} properties 0 value)
  string(JSON nome_uso GET "${bom}" components ${i} properties 0 name)
  string(JSON scope GET "${bom}" components ${i} scope)
  if(NOT nome_uso STREQUAL "k-zero:uso" OR NOT uso MATCHES "^(programma|prove)$")
    fallisci("il componente ${rif} non dice se serve al programma o solo alle prove (k-zero:uso)")
  endif()
  if((uso STREQUAL "programma" AND NOT scope STREQUAL "required") OR (uso STREQUAL "prove" AND NOT scope STREQUAL "excluded"))
    fallisci("il componente ${rif} ha uso ${uso} ma scope ${scope}")
  endif()
endforeach()

# Impronte di un componente: "ALG:valore;ALG:valore".
function(impronte rif uscita)
  set(out "")
  string(JSON n LENGTH "${bom}" components ${indice_${rif}} hashes)
  math(EXPR u "${n} - 1")
  foreach(k RANGE ${u})
    string(JSON alg GET "${bom}" components ${indice_${rif}} hashes ${k} alg)
    string(JSON valore GET "${bom}" components ${indice_${rif}} hashes ${k} content)
    list(APPEND out "${alg}:${valore}")
  endforeach()
  list(SORT out)
  set(${uscita} "${out}" PARENT_SCOPE)
endfunction()

# Indirizzi di un componente (distribution e vcs).
function(indirizzi rif uscita)
  set(out "")
  string(JSON n LENGTH "${bom}" components ${indice_${rif}} externalReferences)
  math(EXPR u "${n} - 1")
  foreach(k RANGE ${u})
    string(JSON url GET "${bom}" components ${indice_${rif}} externalReferences ${k} url)
    list(APPEND out "${url}")
  endforeach()
  set(${uscita} "${out}" PARENT_SCOPE)
endfunction()

# --- Librerie C++ scaricate da CMake ----------------------------------------------------------------------------
file(READ "${SORGENTI}/CMakeLists.txt" cmake)
string(REGEX MATCHALL "FetchContent_Declare\\([^)]*\\)" dichiarazioni "${cmake}")
set(librerie "")
foreach(d IN LISTS dichiarazioni)
  string(REGEX MATCH "FetchContent_Declare\\([ \t\n]*([A-Za-z0-9_]+)" _ "${d}")
  set(nome "${CMAKE_MATCH_1}")
  list(APPEND librerie "${nome}")
  if(NOT nome IN_LIST riferimenti)
    fallisci("manca la libreria ${nome} di CMakeLists.txt")
  endif()
  string(JSON versione GET "${bom}" components ${indice_${nome}} version)
  impronte(${nome} attese)
  indirizzi(${nome} url)
  if(d MATCHES "URL[ \t]+([^ \t\n]+)")
    set(indirizzo "${CMAKE_MATCH_1}")
    string(REGEX MATCH "URL_HASH[ \t]+SHA256=([0-9a-f]+)" _ "${d}")
    set(trovate "SHA-256:${CMAKE_MATCH_1}")
    if(NOT indirizzo MATCHES "[^0-9]${versione}[^0-9]")
      fallisci("la libreria ${nome} ha la versione ${versione}, ma CMakeLists.txt scarica ${indirizzo}")
    endif()
  else()
    string(REGEX MATCH "GIT_REPOSITORY[ \t]+([^ \t\n]+)" _ "${d}")
    set(indirizzo "${CMAKE_MATCH_1}")
    string(REGEX MATCH "GIT_TAG[ \t]+([0-9a-f]+)[ \t]*#[ \t]*v([^ \t\n]+)" _ "${d}")
    set(trovate "SHA-1:${CMAKE_MATCH_1}")
    if(NOT CMAKE_MATCH_2 STREQUAL "${versione}")
      fallisci("la libreria ${nome} ha la versione ${versione}, ma in CMakeLists.txt il commit e' della v${CMAKE_MATCH_2}")
    endif()
  endif()
  if(NOT attese STREQUAL trovate)
    fallisci("la libreria ${nome} ha l'impronta ${attese}, ma CMakeLists.txt fissa ${trovate}")
  endif()
  if(NOT indirizzo IN_LIST url)
    fallisci("la libreria ${nome} non ha l'indirizzo ${indirizzo} di CMakeLists.txt")
  endif()
endforeach()

# --- Pacchetti Python dello strumento degli schemi ----------------------------------------------------------------
# Le righe finiscono con "\" (continua sotto): tolto, una riga alla volta.
file(READ "${SORGENTI}/tests/strumenti/check-jsonschema.txt" requisiti)
string(REPLACE "\\" " " requisiti "${requisiti}")
string(REPLACE "\n" ";" righe "${requisiti}")
set(pacchetti "")
set(pacchetto "")
foreach(r IN LISTS righe)
  if(r MATCHES "^([A-Za-z0-9._-]+)==([^ ]+) ")
    set(pacchetto "pypi-${CMAKE_MATCH_1}")
    list(APPEND pacchetti "${pacchetto}")
    set(versione_${pacchetto} "${CMAKE_MATCH_2}")
    set(impronte_${pacchetto} "")
  elseif(r MATCHES "--hash=sha256:([0-9a-f]+)" AND NOT pacchetto STREQUAL "")
    list(APPEND impronte_${pacchetto} "SHA-256:${CMAKE_MATCH_1}")
  endif()
endforeach()
foreach(p IN LISTS pacchetti)
  if(NOT p IN_LIST riferimenti)
    fallisci("manca il pacchetto ${p} di tests/strumenti/check-jsonschema.txt")
  endif()
  string(JSON versione GET "${bom}" components ${indice_${p}} version)
  if(NOT versione STREQUAL "${versione_${p}}")
    fallisci("${p} ha la versione ${versione}, tests/strumenti/check-jsonschema.txt fissa ${versione_${p}}")
  endif()
  impronte(${p} attese)
  set(trovate ${impronte_${p}})
  list(SORT trovate)
  if(NOT attese STREQUAL trovate)
    fallisci("${p}: le impronte non coincidono con tests/strumenti/check-jsonschema.txt")
  endif()
endforeach()

# Nessun componente in piu' di quelli scaricati davvero.
set(tutti ${librerie} ${pacchetti})
foreach(rif IN LISTS riferimenti)
  if(NOT rif IN_LIST tutti)
    fallisci("il componente ${rif} non e' ne' in CMakeLists.txt ne' in tests/strumenti/check-jsonschema.txt")
  endif()
endforeach()
list(LENGTH librerie quante_librerie)
list(LENGTH pacchetti quanti_pacchetti)
message(STATUS "elenco dei componenti coerente: ${quante_librerie} librerie C++ e ${quanti_pacchetti} pacchetti Python")
