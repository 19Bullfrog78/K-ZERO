{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K-Zero - file di dati elenco_utenti.json, versione 3",
  "description": "Elenco degli utenti trasportati come lo manda il committente (K-019), uno per committente: chi ha diritto al servizio, dove abita, quale scuola, lo stato, la fermata indicata e, per ogni tratta, la ditta e gli orari. Non sono i gruppi dei servizi (il file non dice ne' la fermata ne' il giro). Solo nei pacchetti di livello completo. Lo scrive kzero leggi-elenco; gli sblocchi kzero sblocco; le modifiche a mano (K-020) kzero aggiungi-in-elenco, cambia-in-elenco, togli-da-elenco, rimetti-in-elenco e cancella-da-elenco. Versione 2 (K-020): la colonna di ogni orario e le modifiche a mano non ancora confermate dal file, con il valore di prima. Versione 3 (K-027): gli sblocchi per giorni e periodo (anche a voce), i punti degli utenti (su quale scheda e a quale passaggio salgono o scendono, da quando) e i periodi in cui un utente non frequenta.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_versione",
    "ultimo_numero",
    "elenchi"
  ],
  "properties": {
    "schema": {
      "const": "elenco_utenti",
      "x-kzero-classe": "comune"
    },
    "schema_versione": {
      "const": 3,
      "x-kzero-classe": "comune"
    },
    "ultimo_numero": {
      "description": "Numero dell'ultimo codice dato (U-000001 = 1): i codici non si riusano mai.",
      "type": "integer",
      "minimum": 0,
      "maximum": 999999,
      "x-kzero-classe": "comune"
    },
    "elenchi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "x-kzero-chiave": [
          "committente"
        ],
        "required": [
          "committente",
          "profilo",
          "anno_scolastico",
          "utenti"
        ],
        "properties": {
          "committente": {
            "$ref": "#/definitions/codice",
            "x-kzero-classe": "comune"
          },
          "profilo": {
            "$ref": "#/definitions/codice",
            "description": "Profilo dell'ultima lettura (profili_elenchi.json).",
            "x-kzero-classe": "comune"
          },
          "anno_scolastico": {
            "description": "Anno scolastico dell'ultima lettura, es. 2026-2027.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}$",
            "x-kzero-classe": "comune"
          },
          "ultima_lettura": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "impronta",
              "elenco"
            ],
            "properties": {
              "impronta": {
                "description": "Impronta BLAKE2b-256 del file letto (mai il suo nome).",
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "elenco": {
                "enum": [
                  "completo",
                  "parziale"
                ]
              }
            },
            "x-kzero-classe": "comune"
          },
          "utenti": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/utente"
            }
          }
        }
      },
      "x-kzero-classe": "comune"
    }
  },
  "definitions": {
    "codice": {
      "description": "Codice K-Zero: scelto da chi scrive i dati, unico per tipo di elemento. Lettere senza accenti, cifre, '-', '_' e '.'; inizia con una lettera o una cifra; al massimo 64 caratteri.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "testo": {
      "description": "Testo di una riga, non vuoto (al massimo 300 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "nota": {
      "description": "Testo libero, non vuoto (al massimo 2000 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "data": {
      "description": "Data AAAA-MM-GG che esiste nel calendario (es. 2026-09-14; il 29 febbraio solo negli anni bisestili).",
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$"
    },
    "ora": {
      "description": "Ora HH:MM.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
