{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K-Zero - file di dati contratti.json, versione 1",
  "description": "Contratti tra committenti e aziende, senza importi (file contratti.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_versione", "contratti"],
  "properties": {
    "schema": { "const": "contratti", "x-kzero-classe": "comune" },
    "schema_versione": { "const": 1, "x-kzero-classe": "comune" },
    "contratti": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codice", "committente", "azienda", "regolamento", "assistente_fornito_da"],
        "properties": {
          "codice": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
          "nome": { "$ref": "#/definitions/testo", "x-kzero-classe": "comune" },
          "codici_esterni": { "$ref": "#/definitions/codici_esterni", "x-kzero-classe": "comune" },
          "committente": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
          "azienda": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
          "regolamento": {
            "description": "Regolamento che vale per i servizi del contratto.",
            "$ref": "#/definitions/codice",
            "x-kzero-classe": "comune"
          },
          "valido_dal": { "$ref": "#/definitions/data", "x-kzero-classe": "comune" },
          "valido_al": { "$ref": "#/definitions/data", "x-kzero-classe": "comune" },
          "assistente_fornito_da": { "enum": ["committente", "azienda"], "x-kzero-classe": "comune" },
          "regole": { "$ref": "#/definitions/regole_mezzo", "x-kzero-classe": "comune" },
          "nota": { "$ref": "#/definitions/nota", "x-kzero-classe": "comune" }
        }
      }
    }
  },
  "definitions": {
    "codice": {
      "description": "Codice K-Zero: scelto da chi scrive i dati, unico per tipo di elemento. Lettere senza accenti, cifre, '-', '_' e '.'; inizia con una lettera o una cifra; al massimo 64 caratteri.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "testo": {
      "description": "Testo di una riga, non vuoto (al massimo 300 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "nota": {
      "description": "Testo libero, non vuoto (al massimo 2000 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "data": {
      "description": "Data AAAA-MM-GG che esiste nel calendario (es. 2026-09-14; il 29 febbraio solo negli anni bisestili).",
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$"
    },
    "orario": {
      "description": "Orario HH:MM, ora locale del fuso del pacchetto. Dopo mezzanotte si continua a contare come in GTFS: 24:15 = 00:15 del giorno dopo; al massimo 47:59.",
      "type": "string",
      "pattern": "^([0-3][0-9]|4[0-7]):[0-5][0-9]$"
    },
    "coordinate": {
      "description": "Posizione WGS84 in gradi decimali.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "codici_esterni": {
      "description": "Codici dello stesso elemento in altri sistemi (committenti, orari pubblici, piattaforme).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sistema", "tipo", "codice"],
        "properties": {
          "sistema": { "$ref": "#/definitions/testo" },
          "tipo": { "$ref": "#/definitions/testo" },
          "codice": { "$ref": "#/definitions/testo" }
        }
      }
    },
    "regole_mezzo": {
      "description": "Regole del committente sul mezzo.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posti_minimi": { "description": "Mezzo minimo: posti per i passeggeri.", "type": "integer", "minimum": 1 },
        "posti_massimi": { "description": "Mezzo massimo ammesso: posti per i passeggeri.", "type": "integer", "minimum": 1 },
        "pedana_obbligatoria": { "type": "boolean" },
        "durata_massima_a_bordo_minuti": { "type": "integer", "minimum": 1 },
        "categoria_riconosciuta": {
          "description": "Categoria con cui il committente riconosce il servizio (quella richiesta: un mezzo piu' grande non da' diritto a una categoria piu' alta).",
          "$ref": "#/definitions/testo"
        }
      },
      "minProperties": 1
    }
  }
}
