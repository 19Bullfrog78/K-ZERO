{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K-Zero - file di dati schede_servizi.json, versione 1",
  "description": "Registro delle schede dei servizi del committente lette con kzero leggi-schede (K-021): per ogni scheda (ID) le versioni, ognuna con la copia della scheda letta, da quando a quando vale, la presa in carico, il riferimento, come e' stata scelta la data e gli elementi del pacchetto fatti dalla scheda (servizio, gruppo, corsa, calendario). Dati comuni, tranne le caselle 'individualizzato' e 'attrezzato' (particolari).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_versione",
    "schede"
  ],
  "properties": {
    "schema": {
      "const": "schede_servizi",
      "x-kzero-classe": "comune"
    },
    "schema_versione": {
      "const": 1,
      "x-kzero-classe": "comune"
    },
    "schede": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codice",
          "id",
          "committente",
          "profilo",
          "contratto",
          "versioni"
        ],
        "properties": {
          "codice": {
            "$ref": "#/definitions/codice",
            "description": "Codice K-Zero della scheda, dato dal programma dal Nr della prima versione.",
            "x-kzero-classe": "comune"
          },
          "id": {
            "$ref": "#/definitions/testo",
            "description": "L'ID della scheda del committente (es. un uuid): due schede con ID diversi non si uniscono mai.",
            "x-kzero-classe": "comune"
          },
          "committente": {
            "$ref": "#/definitions/codice",
            "x-kzero-classe": "comune"
          },
          "profilo": {
            "$ref": "#/definitions/codice",
            "description": "Il profilo dell'ultima lettura (profili_schede.json).",
            "x-kzero-classe": "comune"
          },
          "contratto": {
            "$ref": "#/definitions/codice",
            "x-kzero-classe": "comune"
          },
          "versioni": {
            "description": "Le versioni, in ordine: ognuna vale dal suo 'dal' al suo 'al'; i giorni prima della data scelta non cambiano mai.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "x-kzero-chiave": [
                "numero"
              ],
              "required": [
                "numero",
                "dal",
                "al",
                "presa_in_carico",
                "riferimento",
                "scelta",
                "elementi",
                "scheda"
              ],
              "properties": {
                "numero": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "dal": {
                  "$ref": "#/definitions/data",
                  "description": "Primo giorno in cui la versione vale in K-Zero (la data scelta)."
                },
                "al": {
                  "$ref": "#/definitions/data",
                  "description": "Ultimo giorno: la disattivazione, o il giorno prima della versione dopo."
                },
                "al_prima": {
                  "$ref": "#/definitions/data",
                  "description": "Se questa versione ha accorciato quella di prima: la fine che aveva (per togli-scheda)."
                },
                "tolte": {
                  "description": "Numeri delle versioni che questa ha tolto (cominciavano dalla sua data in poi).",
                  "type": "array",
                  "minItems": 0,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "presa_in_carico": {
                  "$ref": "#/definitions/data",
                  "description": "La data della presa in carico (--data), scritta dall'utente."
                },
                "riferimento": {
                  "$ref": "#/definitions/testo",
                  "description": "Il riferimento (es. la mail del committente)."
                },
                "scelta": {
                  "description": "Come e' stata scelta la data da cui vale.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "modo",
                    "da"
                  ],
                  "properties": {
                    "modo": {
                      "enum": [
                        "attivazione",
                        "presa_in_carico",
                        "data"
                      ]
                    },
                    "da": {
                      "description": "nessuna = l'attivazione non era prima della presa in carico (nessuna scelta serviva); file = --validita; scheda = --validita-scheda.",
                      "enum": [
                        "nessuna",
                        "file",
                        "scheda"
                      ]
                    }
                  }
                },
                "elementi": {
                  "description": "Gli elementi del pacchetto fatti da questa versione.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "servizio",
                    "gruppo",
                    "corsa",
                    "calendario"
                  ],
                  "properties": {
                    "servizio": {
                      "$ref": "#/definitions/codice"
                    },
                    "gruppo": {
                      "$ref": "#/definitions/codice"
                    },
                    "corsa": {
                      "$ref": "#/definitions/codice"
                    },
                    "calendario": {
                      "$ref": "#/definitions/codice"
                    }
                  }
                },
                "scheda": {
                  "description": "La copia della scheda come e' stata letta (con i luoghi trovati).",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "nr",
                    "servizio",
                    "verso",
                    "scuole",
                    "attivazione",
                    "disattivazione",
                    "giorni",
                    "totali_alunni",
                    "tot_giorni",
                    "tot_km_carico",
                    "tot_km_vuoto",
                    "calendario",
                    "calendario_base",
                    "cadenza",
                    "forma_cadenza",
                    "nuova_modifica",
                    "fermate"
                  ],
                  "properties": {
                    "nr": {
                      "$ref": "#/definitions/testo",
                      "description": "Il Nr della scheda come sul file (es. '4000123 / 3')."
                    },
                    "servizio": {
                      "$ref": "#/definitions/testo",
                      "description": "Il testo di verso e momento, come nel profilo (es. 'Andata Mattino')."
                    },
                    "verso": {
                      "enum": [
                        "andata",
                        "ritorno"
                      ]
                    },
                    "scuole": {
                      "description": "Le scuole della scheda (scuole.json).",
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/definitions/codice"
                      }
                    },
                    "attivazione": {
                      "$ref": "#/definitions/data"
                    },
                    "disattivazione": {
                      "$ref": "#/definitions/data"
                    },
                    "giorni": {
                      "description": "I giorni segnati.",
                      "type": "array",
                      "minItems": 0,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "lunedi",
                          "martedi",
                          "mercoledi",
                          "giovedi",
                          "venerdi",
                          "sabato",
                          "domenica"
                        ]
                      }
                    },
                    "totali_alunni": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    },
                    "individualizzato": {
                      "description": "La casella 'Servizio Individualizzato' (servizio fatto per un solo utente): dato particolare.",
                      "type": "boolean",
                      "x-kzero-classe": "particolare"
                    },
                    "attrezzato": {
                      "description": "La casella 'Attrezzato' (serve il mezzo con la pedana): dato particolare, come la pedana obbligatoria del servizio.",
                      "type": "boolean",
                      "x-kzero-classe": "particolare"
                    },
                    "tot_giorni": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3660
                    },
                    "tot_km_carico": {
                      "$ref": "#/definitions/km"
                    },
                    "tot_km_vuoto": {
                      "$ref": "#/definitions/km"
                    },
                    "calendario": {
                      "$ref": "#/definitions/testo",
                      "description": "La parola del calendario (es. SCOLASTICO), normalizzata come i codici esterni."
                    },
                    "calendario_base": {
                      "$ref": "#/definitions/codice",
                      "description": "Il calendario del pacchetto con quel codice esterno."
                    },
                    "cadenza": {
                      "$ref": "#/definitions/testo",
                      "description": "La cadenza, come nel profilo."
                    },
                    "forma_cadenza": {
                      "enum": [
                        "giorni_segnati",
                        "date_elencate"
                      ]
                    },
                    "nuova_modifica": {
                      "enum": [
                        "nuova",
                        "modifica"
                      ]
                    },
                    "fermate": {
                      "description": "Le righe della scheda, nell'ordine.",
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "orario",
                          "luogo",
                          "riconosciuto",
                          "salgono",
                          "scendono"
                        ],
                        "properties": {
                          "orario": {
                            "$ref": "#/definitions/orario"
                          },
                          "luogo": {
                            "$ref": "#/definitions/codice",
                            "description": "Il luogo: una scuola (il suo luogo), un luogo pubblico o una casa porta a porta (codice del luogo privato)."
                          },
                          "riconosciuto": {
                            "description": "Come e' stato trovato il punto di raccolta: la scuola (codice esterno della scuola), il codice esterno del luogo, il nome o un nome alternativo, oppure il codice di una casa (colonna della casa).",
                            "enum": [
                              "scuola",
                              "codice_esterno",
                              "nome",
                              "casa"
                            ]
                          },
                          "salgono": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10000
                          },
                          "scendono": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10000
                          },
                          "km_pieni": {
                            "$ref": "#/definitions/km",
                            "description": "Km a pieno scritti su questa riga: coprono il tratto dalla riga prima che ha dei km (una cella vuota = non scritto, mai 0)."
                          },
                          "km_vuoti": {
                            "$ref": "#/definitions/km",
                            "description": "Km a vuoto scritti su questa riga, come sopra."
                          },
                          "accompagnatore": {
                            "description": "L'accompagnatore sale o scende qui (compreso nei numeri della riga, come sulla scheda).",
                            "enum": [
                              "sale",
                              "scende"
                            ]
                          }
                        }
                      }
                    },
                    "date": {
                      "description": "Con la cadenza a date elencate: le date una per una.",
                      "type": "array",
                      "minItems": 0,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/definitions/data"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "x-kzero-classe": "comune"
    },
    "tolte": {
      "description": "Le versioni tolte con kzero togli-scheda (schede scritte per errore): restano scritte qui con il riferimento e la data, e i loro numeri non si danno piu'.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheda",
          "id",
          "versioni",
          "riferimento",
          "data"
        ],
        "properties": {
          "scheda": {
            "$ref": "#/definitions/codice"
          },
          "id": {
            "$ref": "#/definitions/testo"
          },
          "versioni": {
            "description": "Le versioni tolte.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "riferimento": {
            "$ref": "#/definitions/testo"
          },
          "data": {
            "$ref": "#/definitions/data",
            "description": "Scritta dall'utente."
          }
        }
      },
      "x-kzero-classe": "comune"
    }
  },
  "definitions": {
    "codice": {
      "description": "Codice K-Zero: scelto da chi scrive i dati, unico per tipo di elemento. Lettere senza accenti, cifre, '-', '_' e '.'; inizia con una lettera o una cifra; al massimo 64 caratteri.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "testo": {
      "description": "Testo di una riga, non vuoto (al massimo 300 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "parola": {
      "description": "Una parola o un titolo del file del committente, come lo scrive lui (titolo di colonna, sigla, parola dello stato): si confronta senza maiuscole, accenti, punteggiatura e spazi doppi. Non e' un testo libero sulle persone: non entra nell'avviso sui nomi liberi (K-018).",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "data": {
      "description": "Data AAAA-MM-GG che esiste nel calendario (es. 2026-09-14; il 29 febbraio solo negli anni bisestili).",
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$"
    },
    "orario": {
      "description": "Orario HH:MM, ora locale del fuso del pacchetto. Dopo mezzanotte si continua a contare come in GTFS: 24:15 = 00:15 del giorno dopo; al massimo 47:59.",
      "type": "string",
      "pattern": "^([0-3][0-9]|4[0-7]):[0-5][0-9]$"
    },
    "km": {
      "description": "Km, come li scrive il committente (al massimo 10.000).",
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    }
  }
}
