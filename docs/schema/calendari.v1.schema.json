{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K-Zero - file di dati calendari.json, versione 1",
  "description": "Calendari: in quali giorni vale un servizio o una corsa (file calendari.json). Come in GTFS: giorni della settimana dentro un periodo, piu' date aggiunte, meno date tolte; in piu' periodi di sospensione con il motivo e un calendario di base facoltativo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_versione", "calendari"],
  "properties": {
    "schema": { "const": "calendari", "x-kzero-classe": "comune" },
    "schema_versione": { "const": 1, "x-kzero-classe": "comune" },
    "calendari": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codice", "dal", "al", "giorni"],
        "properties": {
          "codice": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
          "nome": { "$ref": "#/definitions/testo", "x-kzero-classe": "comune" },
          "codici_esterni": { "$ref": "#/definitions/codici_esterni", "x-kzero-classe": "comune" },
          "base": {
            "description": "Calendario di base: questo calendario vale solo nei giorni in cui vale anche la base (es. giorni di scuola escluso il sabato).",
            "$ref": "#/definitions/codice",
            "x-kzero-classe": "comune"
          },
          "dal": { "$ref": "#/definitions/data", "x-kzero-classe": "comune" },
          "al": { "$ref": "#/definitions/data", "x-kzero-classe": "comune" },
          "giorni": {
            "description": "Giorni della settimana (anche nessuno, se si usano solo date aggiunte).",
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["lunedi", "martedi", "mercoledi", "giovedi", "venerdi", "sabato", "domenica"] },
            "x-kzero-classe": "comune"
          },
          "date_aggiunte": {
            "description": "Date in cui il calendario vale anche se non e' uno dei giorni indicati.",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/data" },
            "x-kzero-classe": "comune"
          },
          "date_tolte": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/data" },
            "x-kzero-classe": "comune"
          },
          "sospensioni": {
            "description": "Periodi in cui il calendario non vale, con il motivo (es. chiusura del centro).",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dal", "al", "motivo"],
              "properties": {
                "dal": { "$ref": "#/definitions/data", "x-kzero-classe": "comune" },
                "al": { "$ref": "#/definitions/data", "x-kzero-classe": "comune" },
                "motivo": { "$ref": "#/definitions/testo", "x-kzero-classe": "comune" }
              }
            }
          },
          "nota": { "$ref": "#/definitions/nota", "x-kzero-classe": "comune" }
        }
      }
    }
  },
  "definitions": {
    "codice": {
      "description": "Codice K-Zero: scelto da chi scrive i dati, unico per tipo di elemento. Lettere senza accenti, cifre, '-', '_' e '.'; inizia con una lettera o una cifra; al massimo 64 caratteri.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "testo": {
      "description": "Testo di una riga, non vuoto (al massimo 300 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "nota": {
      "description": "Testo libero, non vuoto (al massimo 2000 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "data": {
      "description": "Data AAAA-MM-GG che esiste nel calendario (es. 2026-09-14; il 29 febbraio solo negli anni bisestili).",
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$"
    },
    "orario": {
      "description": "Orario HH:MM, ora locale del fuso del pacchetto. Dopo mezzanotte si continua a contare come in GTFS: 24:15 = 00:15 del giorno dopo; al massimo 47:59.",
      "type": "string",
      "pattern": "^([0-3][0-9]|4[0-7]):[0-5][0-9]$"
    },
    "coordinate": {
      "description": "Posizione WGS84 in gradi decimali.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "codici_esterni": {
      "description": "Codici dello stesso elemento in altri sistemi (committenti, orari pubblici, piattaforme).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sistema", "tipo", "codice"],
        "properties": {
          "sistema": { "$ref": "#/definitions/testo" },
          "tipo": { "$ref": "#/definitions/testo" },
          "codice": { "$ref": "#/definitions/testo" }
        }
      }
    }
  }
}
