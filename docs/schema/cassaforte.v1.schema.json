{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kzero - cassaforte, versione 1",
  "description": "Uscita dei comandi della cassaforte dei dati personali (K-010) con --formato json: chiudi, richiudi, esporta, cassaforte, aggiungi-utente, togli-utente, password, conservazione, cancella. Mai i dati personali o particolari: solo codici, conteggi, utenti e permessi. Spiegati in docs/cassaforte.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_versione", "comando", "utente", "pacchetto", "cassaforte", "fatto", "avvisi", "cancellazione"],
  "definitions": {
    "codice": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "data": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "classi": { "type": "array", "uniqueItems": true, "items": { "enum": ["personali", "particolari"] } },
    "valori": {
      "description": "Quanti valori personali e particolari (contati con le classi degli schemi), mai i valori.",
      "type": "object",
      "additionalProperties": false,
      "required": ["personali", "particolari"],
      "properties": {
        "personali": { "type": "integer", "minimum": 0 },
        "particolari": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schema": { "const": "cassaforte" },
    "schema_versione": { "const": 1 },
    "comando": {
      "enum": ["chiudi", "richiudi", "esporta", "cassaforte", "aggiungi-utente", "togli-utente", "password", "conservazione", "cancella"]
    },
    "utente": { "description": "Chi ha usato la cassaforte.", "$ref": "#/definitions/codice" },
    "pacchetto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codice", "nome"],
      "properties": { "codice": { "type": "string", "minLength": 1 }, "nome": { "type": "string" } }
    },
    "cassaforte": {
      "description": "La cassaforte dopo il comando (null dopo la cancellazione).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "generazione", "conservazione", "conservazione_scaduta", "valori", "utenti", "voci_registro"],
          "properties": {
            "id": { "description": "Codice della cassaforte, come nel manifesto.", "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "generazione": { "description": "Quante volte i dati sono stati chiusi o richiusi.", "type": "integer", "minimum": 1 },
            "conservazione": { "$ref": "#/definitions/data" },
            "conservazione_scaduta": { "type": "boolean" },
            "valori": { "$ref": "#/definitions/valori" },
            "utenti": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["codice", "permessi"],
                "properties": {
                  "codice": { "$ref": "#/definitions/codice" },
                  "permessi": { "$ref": "#/definitions/classi" }
                }
              }
            },
            "voci_registro": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "fatto": { "description": "Cosa e' stato fatto, in italiano.", "type": "string", "minLength": 1 },
    "avvisi": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cancellazione": {
      "description": "Resoconto della cancellazione, da conservare (solo per 'cancella'; null per gli altri comandi).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ora", "cassaforte", "valori", "utenti", "voci_registro"],
          "properties": {
            "ora": { "description": "Data e ora UTC, dall'orologio del PC.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
            "cassaforte": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "valori": { "$ref": "#/definitions/valori" },
            "utenti": { "type": "integer", "minimum": 1 },
            "voci_registro": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
