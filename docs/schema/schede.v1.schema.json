{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kzero - schede, versione 1",
  "description": "Uscita di 'kzero leggi-schede --formato json' (K-021): le schede dei servizi lette dal modello Excel, con l'esito di ognuna (nuova, versione nuova, uguale, ferma, senza la scelta della data), da quando a quando vale, gli elementi fatti, cosa cambia tra due versioni e i problemi. I dati particolari (tipo, pedana, servizio individualizzato, accompagnatore richiesto, le caselle tra le cose che cambiano) solo con --includi-dati-particolari: altrimenti null (con 'riservato'). Nessun valore di una cella nei messaggi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_versione",
    "comando",
    "utente",
    "pacchetto",
    "profilo",
    "committente",
    "contratto",
    "presa_in_carico",
    "riferimento",
    "impronta",
    "scritto",
    "righe",
    "conteggi",
    "schede",
    "problemi",
    "problemi_riservati",
    "avvisi",
    "cassaforte"
  ],
  "properties": {
    "schema": {
      "const": "schede"
    },
    "schema_versione": {
      "const": 1
    },
    "comando": {
      "const": "leggi-schede"
    },
    "utente": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "pacchetto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "nome"
      ],
      "properties": {
        "codice": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "nome": {
          "type": "string"
        }
      }
    },
    "profilo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "committente": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "contratto": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "presa_in_carico": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "riferimento": {
      "type": "string"
    },
    "impronta": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scritto": {
      "type": "boolean"
    },
    "righe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schede",
        "fermate",
        "date"
      ],
      "properties": {
        "schede": {
          "type": "integer"
        },
        "fermate": {
          "type": "integer"
        },
        "date": {
          "type": "integer"
        }
      }
    },
    "conteggi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nuove",
        "versioni_nuove",
        "uguali",
        "ferme",
        "senza_scelta"
      ],
      "properties": {
        "nuove": {
          "type": "integer",
          "minimum": 0
        },
        "versioni_nuove": {
          "type": "integer",
          "minimum": 0
        },
        "uguali": {
          "type": "integer",
          "minimum": 0
        },
        "ferme": {
          "type": "integer",
          "minimum": 0
        },
        "senza_scelta": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schede": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "riga",
          "nr",
          "id",
          "esito",
          "codice",
          "versione",
          "dal",
          "al",
          "scelta",
          "elementi",
          "case_nuove",
          "versione_accorciata",
          "versioni_tolte",
          "giornate_prima_della_presa_in_carico",
          "cambia",
          "particolari"
        ],
        "properties": {
          "riga": {
            "type": "integer",
            "minimum": 0
          },
          "nr": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "esito": {
            "enum": [
              "nuova",
              "versione_nuova",
              "uguale",
              "ferma",
              "senza_scelta"
            ]
          },
          "codice": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "versione": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "dal": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "al": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "scelta": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "modo",
                  "da"
                ],
                "properties": {
                  "modo": {
                    "enum": [
                      "attivazione",
                      "presa_in_carico",
                      "data"
                    ]
                  },
                  "da": {
                    "enum": [
                      "nessuna",
                      "file",
                      "scheda"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "elementi": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "servizio",
                  "gruppo",
                  "corsa",
                  "calendario"
                ],
                "properties": {
                  "servizio": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "gruppo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "corsa": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "calendario": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "case_nuove": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "versione_accorciata": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "versione",
                  "al"
                ],
                "properties": {
                  "versione": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "al": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "versioni_tolte": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "giornate_prima_della_presa_in_carico": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "cambia": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cosa",
                "prima",
                "dopo",
                "riservato"
              ],
              "properties": {
                "cosa": {
                  "type": "string"
                },
                "prima": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dopo": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "riservato": {
                  "type": "boolean"
                }
              }
            }
          },
          "particolari": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tipo",
                  "pedana_obbligatoria",
                  "individualizzato",
                  "assistente_richiesto"
                ],
                "properties": {
                  "tipo": {
                    "enum": [
                      "linea",
                      "scolastico",
                      "disabili",
                      "ncc",
                      "altro"
                    ]
                  },
                  "pedana_obbligatoria": {
                    "type": "boolean"
                  },
                  "individualizzato": {
                    "type": "boolean"
                  },
                  "assistente_richiesto": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "problemi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codice",
          "livello",
          "messaggio",
          "riga"
        ],
        "properties": {
          "codice": {
            "type": "string",
            "pattern": "^K-CTR-[0-9]{3}$"
          },
          "livello": {
            "enum": [
              "errore",
              "avviso"
            ]
          },
          "messaggio": {
            "type": "string"
          },
          "riga": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "problemi_riservati": {
      "type": "integer",
      "minimum": 0
    },
    "avvisi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codice",
          "messaggio"
        ],
        "properties": {
          "codice": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "messaggio": {
            "type": "string"
          }
        }
      }
    },
    "cassaforte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generazione",
        "voci_registro"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "generazione": {
          "type": "integer",
          "minimum": 0
        },
        "voci_registro": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
