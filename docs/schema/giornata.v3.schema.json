{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kzero - giornata, versione 3",
  "description": "Uscita di 'kzero giornata <cartella> --data AAAA-MM-GG [--persona CODICE | --mezzo CODICE] --formato json': i turni del giorno (tutti, di una persona o di un mezzo) con chi li fa e da dove viene l'assegnazione, il mezzo, le corse e le attivita' in ordine con i passaggi, i tempi fermi e i km; i turni scoperti o senza mezzo con il motivo; i totali. I dati sono filtrati secondo le loro classi: di base i dati personali sono sostituiti dal codice dell'elemento e quelli particolari sono 'riservato'. Con errori nei dati del pacchetto la giornata non si produce (errore K-ERR-018); gli errori del piano (K-011, le regole sugli orari) non la bloccano. Versione 2 (K-010): 'cassaforte' (chi l'ha aperta e con quali permessi) e 'non_verificato' (cosa non e' verificato per chi non puo' aprire una classe). Sostituisce la versione 1, che non e' piu' prodotta. Versione 3 (K-011): 'controllo' con gli errori del piano, che non bloccano. Sostituisce la versione 2, che non e' piu' prodotta.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_versione",
    "dati_inventati",
    "dati_personali_inclusi",
    "dati_particolari_inclusi",
    "pacchetto",
    "controllo",
    "cassaforte",
    "non_verificato",
    "data",
    "giorno_della_settimana",
    "festivita",
    "vista",
    "turni",
    "totali"
  ],
  "properties": {
    "schema": {
      "const": "giornata"
    },
    "schema_versione": {
      "const": 3
    },
    "dati_inventati": {
      "type": "boolean"
    },
    "dati_personali_inclusi": {
      "type": "boolean"
    },
    "dati_particolari_inclusi": {
      "type": "boolean"
    },
    "pacchetto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "nome",
        "livello",
        "periodo"
      ],
      "properties": {
        "codice": {
          "$ref": "#/definitions/codice"
        },
        "nome": {
          "type": "string"
        },
        "livello": {
          "enum": [
            "completo",
            "solo_numeri"
          ]
        },
        "periodo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dal",
            "al"
          ],
          "properties": {
            "dal": {
              "$ref": "#/definitions/data"
            },
            "al": {
              "$ref": "#/definitions/data"
            }
          }
        }
      }
    },
    "controllo": {
      "description": "Esito di kzero controlla sullo stesso pacchetto: gli avvisi e gli errori del piano non bloccano; gli errori nei dati si' (allora la giornata non si produce).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errori",
        "errori_del_piano",
        "avvisi"
      ],
      "properties": {
        "errori": {
          "type": "integer",
          "minimum": 0
        },
        "errori_del_piano": {
          "description": "Quanti degli errori sono errori del piano (K-011: violazioni delle regole sugli orari), che non bloccano kzero giornata e kzero ore.",
          "type": "integer",
          "minimum": 0
        },
        "avvisi": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cassaforte": {
      "description": "Cassaforte (K-010): null per un pacchetto senza cassaforte; altrimenti chi l'ha aperta, i suoi permessi e la data di conservazione dei dati.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "utente",
            "permessi",
            "conservazione",
            "conservazione_scaduta",
            "avvisi"
          ],
          "properties": {
            "utente": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "permessi": {
              "description": "Le classi che l'utente puo' aprire.",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "personali",
                  "particolari"
                ]
              }
            },
            "conservazione": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "conservazione_scaduta": {
              "description": "La data di conservazione e' passata (orologio del PC).",
              "type": "boolean"
            },
            "avvisi": {
              "description": "Gli avvisi di ogni apertura, uguali a quelli dell'uscita in testo: data di conservazione passata (K-CTR-097), chiavi nuove ricevute in una busta e password da cambiare (K-CTR-098). Testi del catalogo dei controlli, docs/controlli.md.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "codice",
                  "messaggio"
                ],
                "properties": {
                  "codice": {
                    "enum": [
                      "K-CTR-097",
                      "K-CTR-098"
                    ]
                  },
                  "messaggio": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "non_verificato": {
      "description": "Per ogni classe che l'utente non puo' aprire: cosa della giornata non e' verificato (chi fa i turni e con quali mezzi dipende da dati personali e particolari). Vuoto senza cassaforte o con tutti i permessi.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "servono",
          "cosa"
        ],
        "properties": {
          "servono": {
            "enum": [
              "personali",
              "particolari"
            ]
          },
          "cosa": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data": {
      "$ref": "#/definitions/data"
    },
    "giorno_della_settimana": {
      "enum": [
        "lunedi",
        "martedi",
        "mercoledi",
        "giovedi",
        "venerdi",
        "sabato",
        "domenica"
      ]
    },
    "festivita": {
      "description": "Le festivita' del giorno, dai calendari delle festivita' del pacchetto.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calendario",
          "nome",
          "da_confermare"
        ],
        "properties": {
          "calendario": {
            "$ref": "#/definitions/codice"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "da_confermare": {
            "type": "boolean"
          }
        }
      }
    },
    "vista": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "codice"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "tutti",
            "persona",
            "mezzo"
          ]
        },
        "codice": {
          "oneOf": [
            {
              "$ref": "#/definitions/codice"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "nome",
        "azienda",
        "ipotetica",
        "presa_servizio",
        "mezzo_abituale",
        "assenze"
      ],
      "properties": {
        "codice": {
          "$ref": "#/definitions/codice"
        },
        "nome": {
          "description": "Nome; di base il codice della persona (dato personale). null se il pacchetto non ha il nome.",
          "type": [
            "string",
            "null"
          ]
        },
        "azienda": {
          "$ref": "#/definitions/codice"
        },
        "ipotetica": {
          "type": "boolean"
        },
        "presa_servizio": {
          "oneOf": [
            {
              "$ref": "#/definitions/luogo"
            },
            {
              "type": "null"
            }
          ]
        },
        "mezzo_abituale": {
          "oneOf": [
            {
              "$ref": "#/definitions/codice"
            },
            {
              "type": "null"
            }
          ]
        },
        "assenze": {
          "description": "Assenze del giorno: tipo e orari sono dati personali ('riservato' di base).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "dalle",
              "alle"
            ],
            "properties": {
              "tipo": {
                "type": "string",
                "minLength": 1
              },
              "dalle": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "alle": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          }
        }
      },
      "description": "Solo con --persona: la persona, dove prende servizio, il mezzo abituale e le assenze del giorno."
    },
    "mezzo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "azienda",
        "targa",
        "categoria",
        "posti",
        "posti_in_piedi",
        "uso",
        "scorta",
        "ipotetico",
        "fermi"
      ],
      "properties": {
        "codice": {
          "$ref": "#/definitions/codice"
        },
        "azienda": {
          "$ref": "#/definitions/codice"
        },
        "targa": {
          "type": "string",
          "minLength": 1
        },
        "categoria": {
          "enum": [
            "M1",
            "M2",
            "M3"
          ]
        },
        "posti": {
          "type": "integer",
          "minimum": 0
        },
        "posti_in_piedi": {
          "type": "integer",
          "minimum": 0
        },
        "uso": {
          "oneOf": [
            {
              "$ref": "#/definitions/codice"
            },
            {
              "type": "null"
            }
          ]
        },
        "scorta": {
          "type": "boolean"
        },
        "ipotetico": {
          "type": "boolean"
        },
        "fermi": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "dalle",
              "alle"
            ],
            "properties": {
              "tipo": {
                "$ref": "#/definitions/codice"
              },
              "dalle": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/orario"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "alle": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/orario"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Solo con --mezzo: il mezzo e i suoi fermi del giorno."
    },
    "turni": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/turno"
      }
    },
    "totali": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turni",
        "scoperti",
        "senza_mezzo",
        "persone",
        "mezzi",
        "km_pieni",
        "km_vuoti",
        "minuti_fermi"
      ],
      "properties": {
        "turni": {
          "type": "integer",
          "minimum": 0
        },
        "scoperti": {
          "type": "integer",
          "minimum": 0
        },
        "senza_mezzo": {
          "type": "integer",
          "minimum": 0
        },
        "persone": {
          "type": "integer",
          "minimum": 0,
          "description": "Persone diverse che fanno i turni mostrati."
        },
        "mezzi": {
          "type": "integer",
          "minimum": 0,
          "description": "Mezzi diversi usati dai turni mostrati."
        },
        "km_pieni": {
          "type": "number",
          "minimum": 0,
          "description": "Km dei mezzi guidati: di tutti i turni da autista, della persona (--persona) o del solo mezzo (--mezzo)."
        },
        "km_vuoti": {
          "type": "number",
          "minimum": 0
        },
        "minuti_fermi": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "definitions": {
    "codice": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "data": {
      "description": "Data AAAA-MM-GG che esiste nel calendario (es. 2026-09-14; il 29 febbraio solo negli anni bisestili).",
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$"
    },
    "orario": {
      "description": "HH:MM; dopo la mezzanotte si continua a contare (24:12 = 00:12 del giorno dopo, nello stesso turno).",
      "type": "string",
      "pattern": "^([0-3][0-9]|4[0-7]):[0-5][0-9]$"
    },
    "posizione": {
      "description": "Punto dei dati (file e percorso JSON) in cui e' scritta l'assegnazione.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "puntatore"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "puntatore": {
          "type": "string",
          "pattern": "^(/[^/]*)+$"
        }
      }
    },
    "luogo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "nome"
      ],
      "properties": {
        "codice": {
          "description": "Codice del luogo. Luogo sensibile (K-009): con i dati personali e senza quelli particolari, in una giornata che mostra la casa di un passeggero, 'riservato'. In quel caso anche il nome e' 'riservato'.",
          "$ref": "#/definitions/codice"
        },
        "nome": {
          "description": "Nome del luogo; per un luogo privato, di base, il codice. Valore visibile, oppure il codice dell'elemento (dato personale non mostrato) o 'riservato' (dato particolare non mostrato).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "calendario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "nome",
        "giorni_nel_periodo"
      ],
      "properties": {
        "codice": {
          "$ref": "#/definitions/codice"
        },
        "nome": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "giorni_nel_periodo": {
          "description": "In quanti giorni del periodo del pacchetto vale il calendario.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "nome",
        "azienda",
        "ipotetica"
      ],
      "properties": {
        "codice": {
          "$ref": "#/definitions/codice"
        },
        "nome": {
          "description": "Nome; di base il codice della persona (dato personale). null se il pacchetto non ha il nome.",
          "type": [
            "string",
            "null"
          ]
        },
        "azienda": {
          "$ref": "#/definitions/codice"
        },
        "ipotetica": {
          "type": "boolean"
        }
      }
    },
    "mezzo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codice",
        "azienda",
        "targa",
        "categoria",
        "posti",
        "posti_in_piedi",
        "uso",
        "scorta",
        "ipotetico"
      ],
      "properties": {
        "codice": {
          "$ref": "#/definitions/codice"
        },
        "azienda": {
          "$ref": "#/definitions/codice"
        },
        "targa": {
          "type": "string",
          "minLength": 1
        },
        "categoria": {
          "enum": [
            "M1",
            "M2",
            "M3"
          ]
        },
        "posti": {
          "type": "integer",
          "minimum": 0
        },
        "posti_in_piedi": {
          "type": "integer",
          "minimum": 0
        },
        "uso": {
          "oneOf": [
            {
              "$ref": "#/definitions/codice"
            },
            {
              "type": "null"
            }
          ]
        },
        "scorta": {
          "type": "boolean"
        },
        "ipotetico": {
          "type": "boolean"
        }
      }
    },
    "passaggio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orario",
        "partenza",
        "luogo",
        "nome_luogo",
        "transito",
        "salgono",
        "scendono",
        "km_pieni",
        "km_vuoti",
        "assistente",
        "trasbordi",
        "a_bordo"
      ],
      "properties": {
        "orario": {
          "$ref": "#/definitions/orario"
        },
        "partenza": {
          "oneOf": [
            {
              "$ref": "#/definitions/orario"
            },
            {
              "type": "null"
            }
          ]
        },
        "luogo": {
          "description": "Codice del luogo. Luogo sensibile (K-009): con i dati personali e senza quelli particolari, in una giornata che mostra la casa di un passeggero, 'riservato'.",
          "$ref": "#/definitions/codice"
        },
        "nome_luogo": {
          "description": "Valore visibile, oppure il codice dell'elemento (dato personale non mostrato) o 'riservato' (dato particolare non mostrato, o luogo sensibile come per 'luogo').",
          "type": [
            "string",
            "null"
          ]
        },
        "transito": {
          "type": "boolean"
        },
        "salgono": {
          "type": "integer",
          "minimum": 0
        },
        "scendono": {
          "type": "integer",
          "minimum": 0
        },
        "km_pieni": {
          "type": "number",
          "minimum": 0,
          "description": "Km dal passaggio precedente, come nei dati; al primo passaggio del pezzo di corsa 0."
        },
        "km_vuoti": {
          "type": "number",
          "minimum": 0
        },
        "assistente": {
          "enum": [
            "sale",
            "scende",
            null
          ]
        },
        "trasbordi": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codice",
              "azione",
              "persone"
            ],
            "properties": {
              "codice": {
                "$ref": "#/definitions/codice"
              },
              "azione": {
                "enum": [
                  "consegna",
                  "ricezione"
                ]
              },
              "persone": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "a_bordo": {
          "description": "Persone a bordo dopo il passaggio; null se un gruppo della corsa ha i conteggi non noti.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "attivita": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "attivita",
        "nome",
        "luogo",
        "verso",
        "inizio",
        "fine",
        "fermo_prima_minuti",
        "km_vuoti",
        "usa_il_mezzo",
        "nota"
      ],
      "properties": {
        "tipo": {
          "const": "attivita"
        },
        "attivita": {
          "$ref": "#/definitions/codice"
        },
        "nome": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Nome del tipo di attivita' nell'elenco dell'azienda."
        },
        "luogo": {
          "$ref": "#/definitions/luogo"
        },
        "verso": {
          "oneOf": [
            {
              "$ref": "#/definitions/luogo"
            },
            {
              "type": "null"
            }
          ]
        },
        "inizio": {
          "$ref": "#/definitions/orario"
        },
        "fine": {
          "$ref": "#/definitions/orario"
        },
        "fermo_prima_minuti": {
          "type": "integer",
          "minimum": 0,
          "description": "Minuti fermi tra la fine dell'elemento precedente e l'inizio di questo."
        },
        "km_vuoti": {
          "type": "number",
          "minimum": 0
        },
        "usa_il_mezzo": {
          "type": "boolean"
        },
        "nota": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "corsa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "corsa",
        "nome",
        "intera",
        "inizio",
        "fine",
        "fermo_prima_minuti",
        "km_pieni",
        "km_vuoti",
        "servizi",
        "calendario",
        "assistente",
        "passaggi",
        "modo"
      ],
      "properties": {
        "tipo": {
          "const": "corsa"
        },
        "corsa": {
          "$ref": "#/definitions/codice"
        },
        "nome": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "intera": {
          "description": "false = solo un pezzo della corsa (cambio dell'autista lungo la corsa).",
          "type": "boolean"
        },
        "inizio": {
          "$ref": "#/definitions/orario"
        },
        "fine": {
          "$ref": "#/definitions/orario"
        },
        "fermo_prima_minuti": {
          "type": "integer",
          "minimum": 0
        },
        "km_pieni": {
          "type": "number",
          "minimum": 0
        },
        "km_vuoti": {
          "type": "number",
          "minimum": 0
        },
        "servizi": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
