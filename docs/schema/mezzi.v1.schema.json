{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K-Zero - file di dati mezzi.json, versione 1",
  "description": "Mezzi delle aziende (file mezzi.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_versione", "mezzi"],
  "properties": {
    "schema": { "const": "mezzi", "x-kzero-classe": "comune" },
    "schema_versione": { "const": 1, "x-kzero-classe": "comune" },
    "mezzi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codice", "azienda", "targa", "categoria", "posti"],
        "properties": {
          "codice": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
          "azienda": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
          "targa": { "$ref": "#/definitions/testo", "x-kzero-classe": "comune" },
          "codici_esterni": { "$ref": "#/definitions/codici_esterni", "x-kzero-classe": "comune" },
          "categoria": { "enum": ["M1", "M2", "M3"], "x-kzero-classe": "comune" },
          "posti": {
            "description": "Posti per i passeggeri, conducente escluso (sulla carta di circolazione il campo S.1 lo comprende).",
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "x-kzero-classe": "comune"
          },
          "posti_in_piedi": {
            "description": "Solo se previsti dal libretto (campo S.2).",
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "x-kzero-classe": "comune"
          },
          "carrozzine": { "type": "integer", "minimum": 0, "maximum": 1000, "x-kzero-classe": "comune" },
          "posti_persi_per_carrozzina": { "type": "integer", "minimum": 0, "maximum": 1000, "x-kzero-classe": "comune" },
          "pedana": { "type": "boolean", "x-kzero-classe": "comune" },
          "tempo_pedana_secondi": { "type": "integer", "minimum": 0, "maximum": 3600, "x-kzero-classe": "comune" },
          "ausili_bagagliaio": {
            "description": "Quanti ausili piegati (carrozzine piegate, deambulatori...) entrano nel bagagliaio o nel baule. 0 o assente = niente bagagliaio. Si contano gli ausili, non il loro volume.",
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-kzero-classe": "comune"
          },
          "ausili_tra_i_sedili": {
            "description": "Presente = l'azienda ammette un ausilio piegato tra i sedili, legato e bloccato con cinghie o ancoraggi (scelta facoltativa dell'azienda, che ne risponde): ogni ausilio occupa i posti indicati, solo se sono liberi. Assente = tra i sedili non e' ammesso.",
            "type": "object",
            "additionalProperties": false,
            "required": ["posti_occupati"],
            "properties": {
              "posti_occupati": {
                "description": "Posti a sedere occupati da ogni ausilio fissato tra i sedili (es. 2).",
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "x-kzero-classe": "comune"
          },
          "rimorchio": { "type": "boolean", "x-kzero-classe": "comune" },
          "misure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lunghezza_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "larghezza_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "altezza_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "massa_t": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
              "sbalzo_posteriore_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
            },
            "minProperties": 1,
            "x-kzero-classe": "comune"
          },
          "alimentazione": { "$ref": "#/definitions/alimentazione", "x-kzero-classe": "comune" },
          "costo_fisso_giornaliero": {
            "description": "Nella valuta del pacchetto.",
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "x-kzero-classe": "comune"
          },
          "costo_al_km": {
            "description": "Nella valuta del pacchetto.",
            "type": "number",
            "minimum": 0,
            "maximum": 10000,
            "x-kzero-classe": "comune"
          },
          "ipotetico": {
            "description": "true = mezzo non ancora in flotta (scenari).",
            "type": "boolean",
            "x-kzero-classe": "comune"
          },
          "nota": { "$ref": "#/definitions/nota", "x-kzero-classe": "comune" }
        }
      }
    }
  },
  "definitions": {
    "codice": {
      "description": "Codice K-Zero: scelto da chi scrive i dati, unico per tipo di elemento. Lettere senza accenti, cifre, '-', '_' e '.'; inizia con una lettera o una cifra; al massimo 64 caratteri.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "testo": {
      "description": "Testo di una riga, non vuoto (al massimo 300 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "nota": {
      "description": "Testo libero, non vuoto (al massimo 2000 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "data": {
      "description": "Data AAAA-MM-GG che esiste nel calendario (es. 2026-09-14; il 29 febbraio solo negli anni bisestili).",
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$"
    },
    "orario": {
      "description": "Orario HH:MM, ora locale del fuso del pacchetto. Dopo mezzanotte si continua a contare come in GTFS: 24:15 = 00:15 del giorno dopo; al massimo 47:59.",
      "type": "string",
      "pattern": "^([0-3][0-9]|4[0-7]):[0-5][0-9]$"
    },
    "coordinate": {
      "description": "Posizione WGS84 in gradi decimali.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "codici_esterni": {
      "description": "Codici dello stesso elemento in altri sistemi (committenti, orari pubblici, piattaforme).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sistema", "tipo", "codice"],
        "properties": {
          "sistema": { "$ref": "#/definitions/testo" },
          "tipo": { "$ref": "#/definitions/testo" },
          "codice": { "$ref": "#/definitions/testo" }
        }
      }
    },
    "alimentazione": {
      "description": "Alimentazione; per gli elettrici capacita' della batteria, consumo medio e carica minima.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo"],
      "properties": {
        "tipo": { "enum": ["gasolio", "benzina", "metano", "gpl", "ibrido", "elettrico", "idrogeno", "altro"] },
        "descrizione": { "$ref": "#/definitions/testo" },
        "batteria_kwh": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "consumo_kwh_km": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "carica_minima_percento": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "tipo": { "const": "elettrico" } } },
          "then": { "required": ["batteria_kwh", "consumo_kwh_km", "carica_minima_percento"] }
        },
        { "if": { "properties": { "tipo": { "const": "altro" } } }, "then": { "required": ["descrizione"] } }
      ]
    }
  }
}
