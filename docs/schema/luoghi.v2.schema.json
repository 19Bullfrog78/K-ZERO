{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K-Zero - file di dati luoghi.json, versione 2",
  "description": "Luoghi del pacchetto (file luoghi.json). I codici dei luoghi pubblici e privati sono unici insieme. Versione 2 (K-009): un luogo pubblico puo' essere segnato 'sensibile' (es. un centro diurno o di terapia). La versione 1 si legge ancora.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_versione"],
  "properties": {
    "schema": { "const": "luoghi", "x-kzero-classe": "comune" },
    "schema_versione": { "const": 2, "x-kzero-classe": "comune" },
    "luoghi": {
      "description": "Luoghi pubblici.",
      "type": "array",
      "items": { "$ref": "#/definitions/luogo_pubblico" }
    },
    "luoghi_privati": {
      "description": "Case di persone: dati personali.",
      "type": "array",
      "items": { "$ref": "#/definitions/luogo_privato" }
    }
  },
  "definitions": {
    "codice": {
      "description": "Codice K-Zero: scelto da chi scrive i dati, unico per tipo di elemento. Lettere senza accenti, cifre, '-', '_' e '.'; inizia con una lettera o una cifra; al massimo 64 caratteri.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "testo": {
      "description": "Testo di una riga, non vuoto (al massimo 300 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "nota": {
      "description": "Testo libero, non vuoto (al massimo 2000 caratteri).",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "data": {
      "description": "Data AAAA-MM-GG che esiste nel calendario (es. 2026-09-14; il 29 febbraio solo negli anni bisestili).",
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$"
    },
    "orario": {
      "description": "Orario HH:MM, ora locale del fuso del pacchetto. Dopo mezzanotte si continua a contare come in GTFS: 24:15 = 00:15 del giorno dopo; al massimo 47:59.",
      "type": "string",
      "pattern": "^([0-3][0-9]|4[0-7]):[0-5][0-9]$"
    },
    "coordinate": {
      "description": "Posizione WGS84 in gradi decimali.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "codici_esterni": {
      "description": "Codici dello stesso elemento in altri sistemi (committenti, orari pubblici, piattaforme).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sistema", "tipo", "codice"],
        "properties": {
          "sistema": { "$ref": "#/definitions/testo" },
          "tipo": { "$ref": "#/definitions/testo" },
          "codice": { "$ref": "#/definitions/testo" }
        }
      }
    },
    "luogo_pubblico": {
      "description": "Luogo pubblico: fermata, scuola, centro, rimessa, ricovero esterno, punto di sosta o di trasbordo.",
      "type": "object",
      "additionalProperties": false,
      "required": ["codice", "tipo", "nome", "comune"],
      "properties": {
        "codice": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
        "tipo": {
          "enum": ["fermata", "scuola", "centro", "rimessa", "ricovero_esterno", "punto_sosta", "punto_trasbordo"],
          "x-kzero-classe": "comune"
        },
        "nome": { "description": "Nome ufficiale.", "$ref": "#/definitions/testo", "x-kzero-classe": "comune" },
        "nomi_alternativi": {
          "description": "Altri nomi con cui il luogo compare (schede dei committenti, orari...).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/testo" },
          "x-kzero-classe": "comune"
        },
        "comune": {
          "description": "Comune (obbligatorio: servira' a dividere il lavoro per zone).",
          "$ref": "#/definitions/testo",
          "x-kzero-classe": "comune"
        },
        "coordinate": { "$ref": "#/definitions/coordinate", "x-kzero-classe": "comune" },
        "codici_esterni": { "$ref": "#/definitions/codici_esterni", "x-kzero-classe": "comune" },
        "limiti_accesso": { "$ref": "#/definitions/limiti", "x-kzero-classe": "comune" },
        "trasbordo": {
          "description": "Presente = punto di trasbordo autorizzato.",
          "$ref": "#/definitions/autorizzazione",
          "x-kzero-classe": "comune"
        },
        "sensibile": {
          "description": "Luogo sensibile: dire che una persona ci va lascia capire un dato sulla salute (es. un centro diurno, un centro di terapia). Lo sceglie chi scrive i dati: un doposcuola, anch'esso di tipo 'centro', di solito non lo e'. Quando un'uscita mostra il nome di un passeggero o la sua casa (punto porta a porta) e non i dati particolari, il luogo sensibile diventa 'riservato' dove compare insieme a loro (docs/formato-dati.md, 'Luoghi sensibili').",
          "type": "boolean",
          "x-kzero-classe": "comune"
        },
        "nota": { "$ref": "#/definitions/nota", "x-kzero-classe": "comune" }
      },
      "if": { "properties": { "tipo": { "const": "punto_trasbordo" } } },
      "then": { "required": ["trasbordo"] }
    },
    "luogo_privato": {
      "description": "Luogo privato, cioe' la casa di una persona: punto di salita porta a porta oppure ricovero di un mezzo presso un'abitazione. Tutto tranne codice e tipo e' un dato personale; ammesso solo nei pacchetti di livello completo.",
      "type": "object",
      "additionalProperties": false,
      "required": ["codice", "tipo"],
      "properties": {
        "codice": { "$ref": "#/definitions/codice", "x-kzero-classe": "comune" },
        "tipo": { "enum": ["porta_a_porta", "ricovero_esterno"], "x-kzero-classe": "comune" },
        "nome": { "$ref": "#/definitions/testo", "x-kzero-classe": "personale" },
        "indirizzo": { "$ref": "#/definitions/testo", "x-kzero-classe": "personale" },
        "comune": { "$ref": "#/definitions/testo", "x-kzero-classe": "personale" },
        "coordinate": { "$ref": "#/definitions/coordinate", "x-kzero-classe": "personale" },
        "codici_esterni": { "$ref": "#/definitions/codici_esterni", "x-kzero-classe": "personale" },
        "nota": { "$ref": "#/definitions/nota", "x-kzero-classe": "personale" }
      }
    },
    "limiti": {
      "description": "Limiti di accesso: misure e massa massime, divieti per un mezzo o una categoria di mezzi.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lunghezza_massima_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "larghezza_massima_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "altezza_massima_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "massa_massima_t": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "divieti": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["motivo"],
            "properties": {
              "mezzo": { "description": "Mezzo a cui e' vietato l'accesso...", "$ref": "#/definitions/codice" },
              "categoria": { "description": "...oppure categoria di mezzi a cui e' vietato.", "enum": ["M1", "M2", "M3"] },
              "motivo": { "enum": ["cartello", "esperienza", "altro"] },
              "nota": { "$ref": "#/definitions/nota" }
            },
            "if": { "required": ["mezzo"] },
            "then": { "properties": { "categoria": false } },
            "else": { "required": ["categoria"] }
          }
        }
      },
      "minProperties": 1
    },
    "autorizzazione": {
      "description": "Autorizzazione del committente a usare il luogo come punto di trasbordo: con il documento, oppure a voce.",
      "type": "object",
      "additionalProperties": false,
      "required": ["autorizzato_da", "data"],
      "properties": {
        "autorizzato_da": {
          "description": "Chi ha autorizzato (es. 'CTA sentita la Provincia').",
          "$ref": "#/definitions/testo"
        },
        "data": { "$ref": "#/definitions/data" },
        "documento": { "description": "Riferimento del documento di autorizzazione.", "$ref": "#/definitions/testo" },
        "a_voce": { "description": "true = autorizzato a voce (senza documento).", "type": "boolean" },
        "nota": { "$ref": "#/definitions/nota" }
      },
      "if": { "properties": { "a_voce": { "const": true } }, "required": ["a_voce"] },
      "else": { "required": ["documento"] }
    }
  }
}
